local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local SETTINGS = {
	INVITE_REMOTE_PATH = nil,
	AUTO_FIND_INVITE_REMOTE = true,
	INVITE_NAME_HINTS = { "claninvite", "inviteplayer", "invite", "inviteclan", "joinclan", "addmember", "clanadd" },

	ARGUMENT_MODE = "UserId",
	CUSTOM_INVITE_ARGS = nil,

	CLAN_CHECK_MODE = "Off",
	CLAN_CHECK_REMOTE_PATH = nil,

	CLAN_ATTRIBUTE_NAMES = { "ClanId", "ClanID", "Clan", "ClanName", "ClanTag", "CrewId", "GuildId", "GroupId", "TeamId" },
	TARGET_INVITED_ATTRIBUTE_NAMES = { "PendingClanInvite", "ClanInvite", "InvitedToClan" },

	DELAY_BETWEEN_INVITES = 0.2,
	MAX_INVITES_PER_RUN = 100,
	REMOTE_EVENT_ASSUME_SUCCESS = true,

	SERVER_HOP_MIN_PLAYERS = 5,
	SERVER_HOP_MAX_PLAYERS_RATIO = 0.9,
}

local busy = false
local cachedInviteRemote = nil
local guiInstance = nil

local function notify(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 5,
		})
	end)
end

local function pack(...)
	return { n = select("#", ...), ... }
end

local function unpackArgs(args)
	return unpack(args, 1, args.n)
end

local function getServiceByName(name)
	if name == "ReplicatedStorage" then
		return ReplicatedStorage
	elseif name == "Players" then
		return Players
	end
	local ok, service = pcall(function()
		return game:GetService(name)
	end)
	return ok and service or nil
end

local function getByPath(path)
	if type(path) ~= "table" or #path == 0 then
		return nil
	end
	local object = getServiceByName(path[1])
	if not object then
		return nil
	end
	for index = 2, #path do
		object = object:FindFirstChild(path[index])
		if not object then
			return nil
		end
	end
	return object
end

local function lower(text)
	return string.lower(tostring(text))
end

local function nameLooksLikeInvite(name)
	local lowered = lower(name)
	for _, hint in ipairs(SETTINGS.INVITE_NAME_HINTS) do
		if string.find(lowered, lower(hint), 1, true) then
			return true
		end
	end
	return false
end

local function findInviteRemote()
	if cachedInviteRemote and cachedInviteRemote.Parent then
		return cachedInviteRemote
	end

	if SETTINGS.INVITE_REMOTE_PATH then
		local exact = getByPath(SETTINGS.INVITE_REMOTE_PATH)
		if exact and (exact:IsA("RemoteEvent") or exact:IsA("RemoteFunction")) then
			cachedInviteRemote = exact
			print("[AutoInvite] Found remote by path:", cachedInviteRemote:GetFullName())
			return cachedInviteRemote
		end
	end

	if not SETTINGS.AUTO_FIND_INVITE_REMOTE then
		return nil
	end

	for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
		if (object:IsA("RemoteEvent") or object:IsA("RemoteFunction")) and nameLooksLikeInvite(object.Name) then
			cachedInviteRemote = object
			print("[AutoInvite] Found remote by name:", cachedInviteRemote:GetFullName())
			return cachedInviteRemote
		end
	end

	return nil
end

local function getAttributeFromList(instance, names)
	for _, name in ipairs(names) do
		local value = instance:GetAttribute(name)
		if value ~= nil and value ~= "" then
			return value, name
		end
	end
	return nil, nil
end

local function hasClan()
	if SETTINGS.CLAN_CHECK_MODE == "Off" then
		return true, nil
	end

	if SETTINGS.CLAN_CHECK_REMOTE_PATH then
		local remote = getByPath(SETTINGS.CLAN_CHECK_REMOTE_PATH)
		if not remote then
			return false, "Remote проверки клана не найден."
		end
		if not remote:IsA("RemoteFunction") then
			return false, "Remote проверки клана должен быть RemoteFunction."
		end
		local ok, result = pcall(function()
			return remote:InvokeServer()
		end)
		if not ok then
			return false, "Проверка клана не прошла."
		end
		if type(result) == "table" then
			local value = result.hasClan == true or result.clan ~= nil or result.clanId ~= nil or result.ClanId ~= nil
			return value, value and nil or "Нет клана."
		end
		local value = result == true or result ~= nil
		return value, value and nil or "Нет клана."
	end

	local clanValue = getAttributeFromList(LocalPlayer, SETTINGS.CLAN_ATTRIBUTE_NAMES)
	if clanValue ~= nil then
		return true, nil
	end

	if SETTINGS.CLAN_CHECK_MODE == "Strict" then
		return false, "Нет клана."
	end

	return true, "Клан не виден клиенту, проверка пропущена."
end

local function targetAlreadyInvited(target)
	local value = getAttributeFromList(target, SETTINGS.TARGET_INVITED_ATTRIBUTE_NAMES)
	return value ~= nil
end

local function targetHasClan(target)
	local value = getAttributeFromList(target, SETTINGS.CLAN_ATTRIBUTE_NAMES)
	return value ~= nil
end

local function getCandidates()
	local candidates = {}
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= LocalPlayer and not targetAlreadyInvited(target) and not targetHasClan(target) then
			table.insert(candidates, target)
		end
	end
	return candidates
end

local function buildInviteArguments(target)
	if type(SETTINGS.CUSTOM_INVITE_ARGS) == "function" then
		return pack(SETTINGS.CUSTOM_INVITE_ARGS(LocalPlayer, target))
	end
	if SETTINGS.ARGUMENT_MODE == "Player" then
		return pack(target)
	elseif SETTINGS.ARGUMENT_MODE == "Name" then
		return pack(target.Name)
	end
	return pack(target.UserId)
end

local function tryInviteWithMode(target, mode)
	local remote = findInviteRemote()
	if not remote then
		return false, "Remote инвайта не найден."
	end

	local arg
	if mode == "Player" then
		arg = target
	elseif mode == "Name" then
		arg = target.Name
	else
		arg = target.UserId
	end

	if remote:IsA("RemoteFunction") then
		local ok, result = pcall(function()
			return remote:InvokeServer(arg)
		end)
		if not ok then
			return false, "InvokeServer error"
		end
		if type(result) == "table" then
			if result.ok == false or result.success == false or result.invited == false then
				return false, result.message or "Сервер отказал"
			end
			return true
		end
		return result ~= false
	elseif remote:IsA("RemoteEvent") then
		local ok = pcall(function()
			remote:FireServer(arg)
		end)
		if not ok then
			return false, "FireServer error"
		end
		return SETTINGS.REMOTE_EVENT_ASSUME_SUCCESS
	end
	return false, "Not RemoteEvent/RemoteFunction"
end

local function invite(target)
	if type(SETTINGS.CUSTOM_INVITE_ARGS) == "function" then
		local remote = findInviteRemote()
		if not remote then
			return false, "Remote не найден"
		end
		local args = pack(SETTINGS.CUSTOM_INVITE_ARGS(LocalPlayer, target))
		if remote:IsA("RemoteFunction") then
			local ok, result = pcall(function()
				return remote:InvokeServer(unpackArgs(args))
			end)
			return ok and (result ~= false), result
		elseif remote:IsA("RemoteEvent") then
			pcall(function()
				remote:FireServer(unpackArgs(args))
			end)
			return true
		end
		return false
	end

	local ok, err = tryInviteWithMode(target, SETTINGS.ARGUMENT_MODE)
	if ok then
		return true
	end

	print("[AutoInvite] Mode " .. SETTINGS.ARGUMENT_MODE .. " failed: " .. tostring(err) .. ". Trying others...")

	local modes = { "UserId", "Player", "Name" }
	for _, mode in ipairs(modes) do
		if mode ~= SETTINGS.ARGUMENT_MODE then
			local ok2, err2 = tryInviteWithMode(target, mode)
			if ok2 then
				print("[AutoInvite] Mode " .. mode .. " worked!")
				return true
			end
			print("[AutoInvite] Mode " .. mode .. " also failed: " .. tostring(err2))
		end
	end

	return false, err
end

local function serverHop()
	local placeId = game.PlaceId
	local currentJobId = game.JobId
	
	print("[ServerHop] Searching for better server...")
	status.Text = "S.Hop: поиск..."
	
	local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100"
	
	local success, response = pcall(function()
		return game:HttpGet(url)
	end)
	
	if not success then
		print("[ServerHop] game:HttpGet failed: " .. tostring(response))
		status.Text = "S.Hop: ошибка API"
		notify("S.Hop", "Не удалось получить список серверов. Попробуй позже.")
		return
	end
	
	local httpService = game:GetService("HttpService")
	local ok, data = pcall(function()
		return httpService:JSONDecode(response)
	end)
	
	if not ok or not data.data then
		print("[ServerHop] Failed to parse server list")
		status.Text = "S.Hop: ошибка данных"
		notify("S.Hop", "Ошибка получения данных серверов.")
		return
	end
	
	local bestServer = nil
	local bestPlayerCount = 0
	local maxPlayers = 0
	
	for _, server in ipairs(data.data) do
		if server.id ~= currentJobId and server.playing and server.maxPlayers then
			local ratio = server.playing / server.maxPlayers
			if server.playing >= SETTINGS.SERVER_HOP_MIN_PLAYERS and 
			   ratio >= 0.3 and ratio <= SETTINGS.SERVER_HOP_MAX_PLAYERS_RATIO and
			   server.playing > bestPlayerCount then
				bestServer = server
				bestPlayerCount = server.playing
				maxPlayers = server.maxPlayers
			end
		end
	end
	
	if bestServer then
		print("[ServerHop] Found server: " .. bestPlayerCount .. "/" .. maxPlayers .. " players, JobId: " .. bestServer.id)
		status.Text = "S.Hop: переход..."
		notify("S.Hop", "Переход на сервер " .. bestPlayerCount .. "/" .. maxPlayers .. "...")
		
		local teleportOk, teleportErr = pcall(function()
			TeleportService:TeleportToPlaceInstance(placeId, bestServer.id, LocalPlayer)
		end)
		
		if not teleportOk then
			print("[ServerHop] Teleport failed: " .. tostring(teleportErr))
			status.Text = "S.Hop: ошибка"
			notify("S.Hop", "Ошибка телепортации: " .. tostring(teleportErr))
		end
	else
		print("[ServerHop] No suitable server found")
		status.Text = "S.Hop: нет серверов"
		notify("S.Hop", "Подходящий сервер не найден. Попробуй позже.")
	end
end

