local function setToggle(toggle, knob, active)
	if active then
		toggle.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
		knob:TweenPosition(UDim2.fromOffset(25, 3), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
	else
		toggle.BackgroundColor3 = Color3.fromRGB(64, 70, 86)
		knob:TweenPosition(UDim2.fromOffset(3, 3), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
	end
end

local function runAutoInvite(toggle, knob, status)
	if busy then
		return
	end

	busy = true
	setToggle(toggle, knob, true)
	status.Text = "Проверка клана..."

	local clanOk, clanMessage = hasClan()
	if not clanOk then
		status.Text = clanMessage or "Нет клана."
		notify("Auto Invite", status.Text)
		setToggle(toggle, knob, false)
		busy = false
		return
	end

	local remote = findInviteRemote()
	if not remote then
		status.Text = "Remote инвайта не найден."
		notify("Auto Invite", "Укажи INVITE_REMOTE_PATH вверху скрипта.")
		setToggle(toggle, knob, false)
		busy = false
		return
	end

	print("[AutoInvite] Using remote:", remote:GetFullName(), "| Mode:", SETTINGS.ARGUMENT_MODE)

	local candidates = getCandidates()
	print("[AutoInvite] Candidates:", #candidates)
	for _, c in ipairs(candidates) do
		print("  -", c.Name)
	end

	local invited = 0
	local failed = 0

	if #candidates == 0 then
		status.Text = "Нет кандидатов."
		notify("Auto Invite", "Все игроки уже в клане или приглашены.")
		setToggle(toggle, knob, false)
		busy = false
		return
	end

	status.Text = "Инвайт 0/" .. #candidates

	for index, target in ipairs(candidates) do
		if invited >= SETTINGS.MAX_INVITES_PER_RUN then
			break
		end

		local ok, err = invite(target)
		if ok then
			invited += 1
		else
			failed += 1
			warn("[AutoInvite] Инвайт не прошел для " .. target.Name .. ": " .. tostring(err))
		end

		status.Text = "Инвайт " .. index .. "/" .. #candidates .. " | ok " .. invited
		task.wait(SETTINGS.DELAY_BETWEEN_INVITES)
	end

	status.Text = "Приглашено: " .. invited .. ". Ошибок: " .. failed .. "."
	notify("Auto Invite", "Приглашено игроков: " .. invited .. ". Работа завершена.")
	setToggle(toggle, knob, false)
	busy = false
end

local function unloadGui()
